# Required: Anthropic API key for Claude AI integration
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Your city name or lat/lon for weather
# Default is auto-detected from IP
WEATHER_CITY=New York
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# Optional: Nitter instance for X/Twitter RSS (change if your preferred instance is down)
NITTER_INSTANCE=https://nitter.poast.org
